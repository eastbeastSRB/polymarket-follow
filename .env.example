# The poller's folders, absolute paths, and its database. The run copy takes
# its values from tools/poller.env; a development run points these at
# scratch folders and the test database.
RECORDINGS_ROOT=C:\scratch\polymarket-follow\recordings
STATE_DIR=C:\scratch\polymarket-follow\var
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=polymarket_follow_test
