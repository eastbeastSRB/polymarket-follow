# The run copy's settings, the poller's and its backup's: tools\deploy.ps1
# copies this file into E:\polymarket-follow-run\poller as .env, and the
# poller (config.ts) and tools\backup.cjs read it from their working
# folder, the tasks' (a variable already set in the environment wins).
# Committed because it holds no secret: folders and a database on this PC
# only. A key or password never goes here (CLAUDE.md, External APIs).
RECORDINGS_ROOT=F:\polymarket-follow\recordings
STATE_DIR=E:\polymarket-follow-run\var
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=polymarket_follow
# The dumps (14 daily and 8 weekly kept), and the newest dump's one copy
# (decisions 2026-11-10, (7): F: and E:, never D:).
BACKUP_ROOT=F:\backups\polymarket-follow\db
BACKUP_LATEST=E:\backups\polymarket-follow\db
