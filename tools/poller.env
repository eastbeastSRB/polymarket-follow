# The poller's settings in the run copy: tools\deploy.ps1 copies this file
# into E:\polymarket-follow-run\poller as .env, and the poller reads it from
# its working folder, the task's (config.ts; a variable already set in the
# environment wins). Committed because it holds no secret: folders and a
# database on this PC only. A key or password never goes here (CLAUDE.md,
# External APIs).
RECORDINGS_ROOT=F:\polymarket-follow\recordings
STATE_DIR=E:\polymarket-follow-run\var
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=polymarket_follow
