# The run copy's settings, the poller's and its backup's: tools\deploy.ps1
# copies this file into E:\polymarket-follow-run\poller as .env, and the
# poller (config.ts) and tools\backup.cjs read it from their working
# folder, the tasks' (a variable already set in the environment wins).
# Committed because it holds no secret: folders and a database on this PC
# only. A key or password never goes here (CLAUDE.md, External APIs).
RECORDINGS_ROOT=F:\polymarket-follow\recordings
STATE_DIR=E:\polymarket-follow-run\var
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=polymarket_follow
# The paper experiment's data; its own run copy (E:\polymarket-follow-run\paper)
# reads the collector's rule book in MONGO_DB, read only, and keeps its lock and
# log beside the poller's in STATE_DIR.
PAPER_ROOT=F:\polymarket-follow\paper
# What the experiment cannot read again, copied after each run to another disk.
PAPER_BACKUP=E:\backups\polymarket-follow\paper
# MARKET-1's data; its own run copy (E:\polymarket-follow-run\market1) reads
# the paper experiment's files, the collector's recordings and its rule book,
# read only, and keeps its lock and log beside the others in STATE_DIR.
MARKET1_ROOT=F:\polymarket-follow\market1
# What MARKET-1 cannot read again, copied after each run to another disk.
MARKET1_BACKUP=E:\backups\polymarket-follow\market1
# The dumps (14 daily and 8 weekly kept), and the newest dump's one copy
# (decisions 2026-11-10, (7): F: and E:, never D:).
BACKUP_ROOT=F:\backups\polymarket-follow\db
BACKUP_LATEST=E:\backups\polymarket-follow\db
